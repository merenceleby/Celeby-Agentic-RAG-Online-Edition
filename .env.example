GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# AI Studio'daki gerçek limitlere bak, güvenli tarafta kal
LLM_RPM=10
LLM_RPD=500
# Docker Compose bunu otomatik olarak redis servisine ayarlar
REDIS_URL=redis://localhost:6379/0

# --- Opsiyonel ---
# Ana model 503/yoğunluk verirse otomatik geçilecek yedek model
# LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
# Lokal embedding ve reranker modelleri (varsayılan: TR+EN çok dilli)
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Dakikalık token limiti varsa gir (0 = kapalı). Çağrı başına tahmini token sayısı da ayarlanabilir.
# LLM_TPM=0
# LLM_EST_TOKENS_PER_CALL=3500
# Lite Eval: cevap cümlesinin kaynağa "yakın" sayılması için gereken benzerlik eşiği
# EVAL_SUPPORT_THRESHOLD=0.5

# --- Deploy için Giriş Koruması (lokalde false kalır) ---
# AUTH_ENABLED=true
# AUTH_USERNAME=admin
# AUTH_PASSWORD=guclu-bir-sifre
# AUTH_SECRET=rastgele-uzun-bir-anahtar
